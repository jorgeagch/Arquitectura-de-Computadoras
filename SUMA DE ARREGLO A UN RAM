#include <stdio.h>

int main(void) {
    int arreglo[5] = {10, 20, 30, 40, 50};
    int suma = 0;

    __asm__ (
        "movl 0(%1), %%eax\n\t"
        "addl 4(%1), %%eax\n\t"
        "addl 8(%1), %%eax\n\t"
        "addl 12(%1), %%eax\n\t"
        "addl 16(%1), %%eax\n\t"
        : "=a" (suma)
        : "r" (arreglo)
    );

    printf("Suma: %d\n", suma);
    return 0;
}
